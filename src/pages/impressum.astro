---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/impressum.css';
---

<BaseLayout title="Impressum">
  <section class="impressum section">
    <div class="container">
      <h1>Impressum</h1>

      <div class="impressum-block">
        <h2>Angaben gemäss Art. 3 UWG</h2>
        <p>
          Frauenverein Sarmenstorf<br />
          5614 Sarmenstorf<br />
          Schweiz
        </p>
        <p class="impressum-note">
          An diese Adresse gesendete Post wird der Präsidentin des Vereins zugestellt.
        </p>
      </div>

      <div class="impressum-block">
        <h2>Kontakt</h2>
        <p>
          E-Mail:
          <a href="mailto:info@frauenverein-sarmenstorf.ch">info@frauenverein-sarmenstorf.ch</a>
        </p>
      </div>

      <div class="impressum-block">
        <h2>Haftungsausschluss</h2>
        <p>
          Der Frauenverein Sarmenstorf übernimmt keine Gewähr für die Richtigkeit,
          Genauigkeit, Aktualität, Zuverlässigkeit und Vollständigkeit der Informationen
          auf dieser Website. Haftungsansprüche gegen den Frauenverein Sarmenstorf wegen
          Schäden materieller oder immaterieller Art, welche aus dem Zugriff oder der
          Nutzung bzw. Nichtnutzung der veröffentlichten Informationen, durch Missbrauch
          der Verbindung oder durch technische Störungen entstanden sind, werden
          ausgeschlossen.
        </p>
      </div>

      <div class="impressum-block">
        <h2>Links</h2>
        <p>
          Verweise und Links auf Webseiten Dritter liegen ausserhalb unseres
          Verantwortungsbereichs. Es wird jegliche Verantwortung für solche Webseiten
          abgelehnt.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
