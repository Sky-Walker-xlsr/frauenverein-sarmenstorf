---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/galerie.css';
---

<BaseLayout title="Galerie" description="Eindrücke von unseren Anlässen.">
  <section class="section">
    <div class="container">
      <h1>Galerie</h1>

      <div id="albums"></div>

      <div class="gallery" id="gallery"></div>

      <p class="gallery-empty" id="gallery-empty" style="display:none">
        Aktuell sind keine Bilder vorhanden.
      </p>
    </div>
  </section>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose" aria-label="Schliessen">&times;</button>
    <img id="lightboxImg" src="" alt="" />
  </div>
</BaseLayout>

<script>
  import { supabase, GALLERY_BUCKET } from '../lib/supabase';

  interface AlbumRow {
    id: string;
    title: string;
    description: string | null;
  }

  interface GalleryImage {
    storage_path: string;
    alt: string | null;
    album_id: string | null;
  }

  const albumsEl = document.getElementById('albums') as HTMLElement;
  const gallery = document.getElementById('gallery') as HTMLElement;
  const empty = document.getElementById('gallery-empty') as HTMLElement;
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const lightboxClose = document.getElementById('lightboxClose') as HTMLButtonElement;

  function openLightbox(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.classList.add('open');
  }

  function closeLightbox() {
    lightbox.classList.remove('open');
    lightboxImg.src = '';
  }

  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  function makeImg(img: GalleryImage): HTMLImageElement {
    const { data: urlData } = supabase.storage.from(GALLERY_BUCKET).getPublicUrl(img.storage_path);
    const el = document.createElement('img');
    el.src = urlData.publicUrl;
    el.alt = img.alt ?? '';
    el.loading = 'lazy';
    el.addEventListener('click', () => openLightbox(el.src, el.alt));
    return el;
  }

  function buildCarousel(images: GalleryImage[]): HTMLElement {
    const carousel = document.createElement('div');
    carousel.className = 'carousel';

    const track = document.createElement('div');
    track.className = 'carousel-track';

    // Duplicate the sequence so the looping animation (0% -> -50%) is seamless.
    [...images, ...images].forEach((img) => track.appendChild(makeImg(img)));

    // Roughly constant speed regardless of image count.
    track.style.animationDuration = `${images.length * 6}s`;

    carousel.appendChild(track);
    return carousel;
  }

  (async () => {
    const [albumsRes, imagesRes] = await Promise.all([
      supabase.from('gallery_albums').select('id, title, description').order('sort_order', { ascending: true }).order('created_at', { ascending: true }),
      supabase
        .from('gallery_images')
        .select('storage_path, alt, album_id')
        .order('sort_order', { ascending: true })
        .order('created_at', { ascending: true }),
    ]);

    const albums = (albumsRes.data ?? []) as AlbumRow[];
    const images = (imagesRes.data ?? []) as GalleryImage[];

    // Albums with their assigned pictures, as rotating carousels.
    albums.forEach((album) => {
      const albumImages = images.filter((img) => img.album_id === album.id);
      if (albumImages.length === 0) return;

      const section = document.createElement('section');
      section.className = 'gallery-album';

      const title = document.createElement('h2');
      title.textContent = album.title;
      section.appendChild(title);

      if (album.description) {
        const desc = document.createElement('p');
        desc.className = 'gallery-album-description';
        desc.textContent = album.description;
        section.appendChild(desc);
      }

      section.appendChild(buildCarousel(albumImages));
      albumsEl.appendChild(section);
    });

    if (images.length === 0) {
      empty.style.display = '';
      return;
    }

    // Remaining unassigned images, as a plain grid (as before).
    const poolImages = images.filter((img) => !img.album_id);
    poolImages.forEach((img) => gallery.appendChild(makeImg(img)));
  })();
</script>
